// Prisma schema — PostgreSQL
// npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  guides       Guide[]
}

model Merchant {
  id             String   @id @default(cuid())
  name           String   @unique          // "Amazon India", "Flipkart"
  slug           String   @unique
  logoUrl        String?
  network        String?                    // "direct", "earnkarto", "cuelinks", "admitad"
  affiliateTagId String?                    // your tag/publisher id for this merchant
  baseUrl        String?
  isActive       Boolean  @default(true)
  offers         Offer[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  description String?
  products    Product[]
  guides      Guide[]
  createdAt   DateTime   @default(now())

  @@index([parentId])
}

model Product {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  brand         String?
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  description   String?       @db.Text
  specs         Json?         // normalized spec object, e.g. {"ram": "8GB", "storage": "128GB"}
  images        ProductImage[]
  offers        Offer[]
  isPublished   Boolean       @default(false)
  metaTitle     String?
  metaDescription String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([categoryId])
  @@index([brand])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)

  @@index([productId])
}

model Offer {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchantId      String
  merchant        Merchant       @relation(fields: [merchantId], references: [id])
  price           Decimal        @db.Decimal(10, 2)
  mrp             Decimal?       @db.Decimal(10, 2)
  currency        String         @default("INR")
  couponCode      String?
  couponDesc      String?
  inStock         Boolean        @default(true)
  rating          Decimal?       @db.Decimal(2, 1)
  ratingCount     Int?
  deepLink        String         @db.Text   // raw merchant product URL (never shown to client directly)
  affiliateUrl    String         @db.Text   // final tagged affiliate URL used server-side
  lastCheckedAt   DateTime       @default(now())
  priceHistory    PriceHistory[]
  clickEvents     ClickEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([productId, merchantId])
  @@index([productId])
  @@index([merchantId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())

  @@index([offerId, recordedAt])
}

model ClickEvent {
  id         String   @id @default(cuid())
  offerId    String
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sessionId  String?
  ipHash     String?          // salted hash only, never raw IP
  userAgent  String?
  referrer   String?
  createdAt  DateTime @default(now())

  @@index([offerId, createdAt])
}

model Guide {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  bodyMdx         String     @db.Text
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id])
  authorId        String?
  author          AdminUser? @relation(fields: [authorId], references: [id])
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean    @default(false)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([categoryId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
